  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@stockmind.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "https://localhost:7000/api/auth/login",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
