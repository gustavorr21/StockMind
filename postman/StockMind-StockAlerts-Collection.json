              }
            ],
            "url": {
              "raw": "https://localhost:7000/api/stock-alerts?page=1&pageSize=10",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7000",
              "path": ["api", "stock-alerts"],
              "query": [
                {
                  "key": "page",
